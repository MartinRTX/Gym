<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fondo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CARRERA"
        android:textColor="@color/w_rojo"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_dias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/w_texto"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_dias_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="días"
            android:textColor="@color/w_suave"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_trote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text=""
        android:textColor="@color/w_texto"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_aviso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/w_abre"
        android:textColor="@color/w_suave"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
